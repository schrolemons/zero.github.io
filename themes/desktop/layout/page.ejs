<!-- themes/desktop/layout/page.ejs -->
<div style="position: fixed; top: 24px; left: 24px; z-index: 100;">
    <a href="<%- url_for('/') %>" class="back-btn">
        <svg class="svg-icon" style="vertical-align: middle; margin-right: 4px; width: 16px; height: 16px;"
            viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        放回桌面
    </a>
</div>

<article class="post-container module"
    style="position: relative; margin: 80px auto 40px auto; transform: none; max-width: 800px; width: 90%; cursor: auto;">
    <h1 style="font-size: 28px; margin-bottom: 8px;"><%- page.title %></h1>

    <% if (page.type !=='tags' && page.type !=='categories' ) { %>
        <div class="post-meta" style="margin-bottom: 32px;">
            发布于 <%= date(page.date, 'YYYY.MM.DD' ) %>
        </div>
        <% } else { %>
            <div style="margin-bottom: 32px;"></div>
            <% } %>

                <div class="post-content">
                    <% if (page.type==='tags' ) { %>
                        <div class="tag-cloud">
                            <%- tagcloud({ min_font: 13, max_font: 24, amount: 100, color: true, start_color: '#737373'
                                , end_color: '#1A1A1A' }) %>
                        </div>
                        <% } else if (page.type==='categories' ) { %>
                            <div class="category-tree">
                                <%- list_categories({ show_count: true }) %>
                            </div>
                            <% } else { %>
                                <%- page.content %>
                                    <% } %>
                </div>
</article>